port="8080"
mode="dev"
url="http://localhost:8080"
key="key_must_length_32"

[logger]
level="info"

[storage]
path="/path/to/uploads"

[db]
username="username"
password="password"
database="db_name"
host="localhost"
port="3306"
tls=false

[db.table]
prefix=""

[redis]
host="127.0.0.1"
password=""
port="6379"
db=0
prefix="app"

[queue]
prefix="test"
topics=["default"]

[queue.consumer]
name="default"
group="default"

[oauth]
key="oauth_app_id_or_key"
secret="oauth_app_secret"
api="https://www.example.com"
publicKeyPath="/path/to/oauth-public.key"

[auth.api]
secret="32-chars-length"
audience="name of this api"
issuers=[ "allowed name of issuer" ]

[ui]
assetMode="embedded"
viteDevOrigin="http://127.0.0.1:5173"

[configcenter]
enabled=false
username=""
password=""

[configload]
enabled=false
# Use "database" for a trusted direct database load, or "http" for the runtime API.
source="http"
namespace=""
environment=""

[configload.http]
baseURL="http://127.0.0.1:8080"
apiKey=""
timeout="5s"

[configcrypt]
enabled=true
provider="file"
activeKey="config-key-v1"
keyring="/absolute/path/to/config-center-keys.json"
